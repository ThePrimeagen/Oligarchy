#!/bin/sh
# Bundled like ./client: one bytecode cache instead of loading the graph on every launch. The
# bundle is rebuilt when a source (the workspace packages' included), the lockfile or this wrapper
# is newer than either of its two files, or one is missing; a failed build prints the build's
# output and one line saying so, then runs the sources as they are. Bun ignores a bytecode cache
# that does not match its .js, and two builds landing at once leave one file older than the edit
# that separated them, so a torn refresh runs the sources' truth at the latest one call later. The
# outputs carry the time the build started, so a source edited while it ran still counts as newer.
# Bytecode is CommonJS, so `import.meta` is not a value: ConfigProvider.fromEnv only touches
# `import.meta?.env`, and the settings loader in @oligarchy/env reads `import.meta.url` once to
# find the workspace root; oligarchy.json, client.md and the prompts resolve from that root. One
# url, the loader's, keeps them all beside the package. Stack traces name the bundle; `bun run
# driver` runs the sources for one that names them.
root=$(CDPATH= cd "$(dirname "$0")" && pwd)
cache="$root/node_modules/.cache/oligarchy/driver"
meta=$(printf 'import.meta={"url":"file://%s/packages/env/src/oligarchy.ts"}' "$root")
if [ ! -f "$cache/main.js" ] || [ ! -f "$cache/main.js.jsc" ] ||
  [ -n "$(find "$root/src" "$root/packages" "$root/bun.lock" "$root/driver" \( -newer "$cache/main.js" -o -newer "$cache/main.js.jsc" \) -print)" ]; then
  tmp="$cache.$$"
  mkdir -p "$tmp" && touch "$tmp/stamp" &&
    output=$(bun build --target=bun --bytecode --define "$meta" --outdir "$tmp" "$root/src/driver/main.ts" 2>&1) &&
    touch -r "$tmp/stamp" "$tmp/main.js" "$tmp/main.js.jsc" &&
    mkdir -p "$cache" && mv -f "$tmp/main.js" "$tmp/main.js.jsc" "$cache/"
  built=$?
  rm -rf "$tmp"
  if [ $built -ne 0 ]; then
    [ -n "$output" ] && printf '%s\n' "$output" >&2
    echo "driver: bundle build failed; running the sources" >&2
    exec bun --no-env-file "$root/src/driver/main.ts" "$@"
  fi
fi
exec bun --no-env-file "$cache/main.js" "$@"
