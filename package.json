{
  "name": "oligarchy",
  "private": true,
  "bin": {
    "client": "src/client/main.ts",
    "ctrl": "src/ctrl/main.ts",
    "driver": "src/driver/main.ts",
    "session": "src/session/main.ts",
    "viz": "src/viz/main.ts"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-node": "4.0.0-rc.112",
      "@effect/vitest": "4.0.0-rc.112",
      "@sentry/bun": "10.73.0",
      "@sentry/cloudflare": "10.73.0",
      "@sentry/effect": "10.73.0",
      "@types/node": "^26.4.0",
      "@types/pg": "^8.23.1",
      "drizzle-orm": "^0.45.2",
      "effect": "4.0.0-rc.112",
      "pg": "^8.23.0",
      "typescript": "7.0.2",
      "vitest": "^4.1.11"
    }
  },
  "type": "module",
  "scripts": {
    "client": "bun --no-env-file src/client/main.ts",
    "driver": "bun --no-env-file src/driver/main.ts",
    "ctrl": "bun --no-env-file --preload ./packages/observability/src/instrument.ts src/ctrl/main.ts",
    "session": "bun --no-env-file src/session/main.ts",
    "viz": "bun --no-env-file --preload ./src/viz/preload.ts src/viz/main.ts",
    "qemu-server": "bun --no-env-file --preload ./packages/observability/src/instrument.ts src/qemu-server/main.ts",
    "qemu-reverse-proxy": "bun --no-env-file --preload ./packages/observability/src/instrument.ts src/qemu-reverse-proxy/main.ts",
    "automation-server": "bun --no-env-file --preload ./packages/observability/src/instrument.ts src/automation-server/main.ts",
    "automation-client": "bun --no-env-file --preload ./packages/observability/src/instrument.ts src/automation-client/main.ts",
    "dev": "wrangler dev --remote --env local",
    "check:lint": "oxlint --deny-warnings .",
    "check:format": "oxfmt --check .",
    "format": "oxfmt .",
    "check:types": "tsc --noEmit -p tsconfig.json && bun run --workspaces check:types",
    "test:unit": "bun --bun vitest run --project unit && bun run --workspaces test:unit",
    "test:integration": "bun --bun vitest run --project integration --maxWorkers 1 && bun run --workspaces --if-present test:integration",
    "check:fast": "bun run check:lint && bun run check:format && bun run check:types && bun run test:unit",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun --no-env-file packages/db/src/migrate.ts",
    "prod:db:migrate": "env -u DATABASE_MIGRATION_URL bun --no-env-file packages/db/src/migrate.ts --env-file .prod-env",
    "test:db:migrate": "env -u DATABASE_MIGRATION_URL bun --no-env-file packages/db/src/migrate.ts --env-file .env",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@oligarchy/db": "workspace:*",
    "@oligarchy/env": "workspace:*",
    "@oligarchy/fleet": "workspace:*",
    "@oligarchy/http": "workspace:*",
    "@oligarchy/jobs": "workspace:*",
    "@oligarchy/linear": "workspace:*",
    "@oligarchy/log": "workspace:*",
    "@oligarchy/observability": "workspace:*",
    "@oligarchy/shared": "workspace:*",
    "@opentui/core": "0.5.11",
    "@opentui/solid": "0.5.11",
    "@sentry/cloudflare": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "hono": "^4.13.5",
    "pg": "catalog:",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-typescript": "7.27.1",
    "@effect/tsgo": "0.41.0",
    "@effect/vitest": "catalog:",
    "@oligarchy/testing": "workspace:*",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "babel-preset-solid": "1.9.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.127.1"
  },
  "overrides": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
