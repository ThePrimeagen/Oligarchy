{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.wrangler/**",
    "packages/db/drizzle/**",
    "public/**",
    "prompts/**",
    "**/*.md",
    "bun.lock",
    "**/wrangler.jsonc"
  ]
}
