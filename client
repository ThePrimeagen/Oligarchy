#!/bin/sh
# A driving agent calls this many times per task, so it runs one bundle with a bytecode cache
# instead of loading three hundred modules on every call. The bundle is rebuilt when a source, the
# lockfile or this wrapper is newer than it; a failed build says so and runs the sources as they
# are. Bun ignores a bytecode cache that does not match its .js, so a torn refresh only costs
# speed. The outputs carry the time the build started, so a source edited while it ran still
# counts as newer. `import.meta` is defined away because the bytecode format is CommonJS, where
# the graph's one use (ConfigProvider.fromEnv's `import.meta?.env`) would not parse. Stack traces
# name the bundle; `bun run client` runs the sources for one that names them.
root=$(dirname "$0")
cache="$root/node_modules/.cache/oligarchy/client"
if [ ! -f "$cache/main.js.jsc" ] ||
  [ -n "$(find "$root/src" "$root/bun.lock" "$root/client" -newer "$cache/main.js.jsc" -print -quit)" ]; then
  tmp="$cache.$$"
  mkdir -p "$tmp" && touch "$tmp/stamp" &&
    output=$(bun build --target=bun --bytecode --define 'import.meta={}' --outdir "$tmp" "$root/src/client/main.ts" 2>&1) &&
    touch -r "$tmp/stamp" "$tmp/main.js" "$tmp/main.js.jsc" &&
    mkdir -p "$cache" && mv -f "$tmp/main.js" "$tmp/main.js.jsc" "$cache/"
  built=$?
  rm -rf "$tmp"
  if [ $built -ne 0 ]; then
    [ -n "$output" ] && printf '%s\n' "$output" >&2
    echo "client: bundle build failed; running the sources" >&2
    exec bun --no-env-file "$root/src/client/main.ts" "$@"
  fi
fi
exec bun --no-env-file "$cache/main.js" "$@"
