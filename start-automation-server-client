#!/usr/bin/env bash
# start-automation-server-client <max-jobs>
#
# The automation half of the fleet on this machine: one automation server on 127.0.0.1:54321 (what
# the tunnel's automation hostname points at) and one automation client on 127.0.0.1:54322 that
# carries <max-jobs> runs at once, both in the foreground of this shell. Ctrl-C or a TERM asks
# both to stop; another one kills them. One of them exiting stops the other. Exit 0 when both
# ended cleanly, 1 otherwise.
#
# The model is oligarchy.json, read by the server and by ./driver. This script does not take one.
# Runs from the current directory, as ./automation-server does: its .env fills what the
# environment lacks. SERVER_URL must name the qemu reverse proxy the client reserves guests from.
set -u

ROOT=$(dirname "$0")
SERVER_PORT=54321
CLIENT_PORT=54322

usage() {
  echo "usage: start-automation-server-client <max-jobs>" >&2
  echo "  max-jobs  how many runs the client carries at once, a positive integer" >&2
  exit 1
}

[ $# -eq 1 ] || usage
case "$1" in
  '' | *[!0-9]* | 0*) usage ;;
esac
MAX_JOBS=$1

# Without it the client falls back to a qemu server's default port, which is nothing on the
# machine that runs this half; an empty value, quoted or not, counts as unset, as it does for
# the processes.
if [ -z "${SERVER_URL:-}" ] && ! grep -qE "^SERVER_URL=[\"']?https?://" .env 2>/dev/null; then
  echo "SERVER_URL is not set; the automation client reserves guests from the qemu reverse proxy (https://oligarchy-server.trm.sh, or http://127.0.0.1:55555 on the proxy's own machine)" >&2
  exit 1
fi

"$ROOT/automation-server" --port "$SERVER_PORT" &
SERVER=$!
"$ROOT/automation-client" --name "automation-client-$(uname -n)" --max-jobs "$MAX_JOBS" \
  --port "$CLIENT_PORT" --url "http://127.0.0.1:$CLIENT_PORT" &
CLIENT=$!

# The first signal asks. A second one kills: a child waiting on a response must not hold this
# shell, and ignoring the signal would make that second Ctrl-C do nothing.
asked=0
request_stop() {
  asked=1
  kill -TERM "$SERVER" "$CLIENT" 2>/dev/null || true
}
on_signal() {
  if [ "$asked" -eq 0 ]; then
    request_stop
  else
    kill -KILL "$SERVER" "$CLIENT" 2>/dev/null || true
  fi
}
trap on_signal INT TERM
# Returns when the first of the two exits, or at once when a signal arrives (its trap has run).
wait -n "$SERVER" "$CLIENT" || true
if [ "$asked" -eq 0 ]; then
  request_stop
fi
# Wait out each child. A signal interrupts wait while it is still alive; the trap has run, and
# the loop collects the status once the process is gone.
reap() {
  local code=0
  while kill -0 "$1" 2>/dev/null; do
    wait "$1"
    code=$?
  done
  wait "$1" 2>/dev/null
  local reaped=$?
  if [ "$reaped" -ne 127 ]; then
    code=$reaped
  fi
  return "$code"
}
reap "$SERVER"
SERVER_CODE=$?
reap "$CLIENT"
CLIENT_CODE=$?
[ "$SERVER_CODE" -eq 0 ] && [ "$CLIENT_CODE" -eq 0 ]
