#!/usr/bin/env bash
# start-server-proxy-client <max-jobs>
#
# The QEMU half of the fleet on this machine: one qemu reverse proxy on 127.0.0.1:55555 (what the
# tunnel's server hostname points at) and one qemu server on 127.0.0.1:42069 that runs <max-jobs>
# sessions at once, both in the foreground of this shell. Ctrl-C or a TERM asks both to stop;
# another one kills them. One of them exiting stops the other. Exit 0 when both ended cleanly,
# 1 otherwise.
#
# Runs from the current directory, as ./qemu-server does: its .env fills what the environment
# lacks. The iso cache and minted disks go where --data-dir defaults (OLIGARCHY_DATA_DIR, else
# ~/.oligarchy).
set -u

ROOT=$(dirname "$0")
PROXY_PORT=55555
SERVER_PORT=42069

usage() {
  echo "usage: start-server-proxy-client <max-jobs>" >&2
  echo "  max-jobs  how many sessions the qemu server runs at once, a positive integer" >&2
  exit 1
}

[ $# -eq 1 ] || usage
case "$1" in
  '' | *[!0-9]* | 0*) usage ;;
esac
MAX_JOBS=$1

# A session directory on tmpfs has killed QEMU mid-screendump, and the qemu server takes TMPDIR
# from its environment, never from .env: unless the operator says where, sessions live under HOME.
export TMPDIR="${TMPDIR:-$HOME/.oligarchy/sessions}"
mkdir -p "$TMPDIR" || exit 1

"$ROOT/qemu-reverse-proxy" --port "$PROXY_PORT" &
PROXY=$!
"$ROOT/qemu-server" --name "qemu-server-$(uname -n)" --max-jobs "$MAX_JOBS" \
  --port "$SERVER_PORT" --url "http://127.0.0.1:$SERVER_PORT" &
SERVER=$!

# The first signal asks. A second one kills: a child waiting on a response must not hold this
# shell, and ignoring the signal would make that second Ctrl-C do nothing.
asked=0
request_stop() {
  asked=1
  kill -TERM "$PROXY" "$SERVER" 2>/dev/null || true
}
on_signal() {
  if [ "$asked" -eq 0 ]; then
    request_stop
  else
    kill -KILL "$PROXY" "$SERVER" 2>/dev/null || true
  fi
}
trap on_signal INT TERM
# Returns when the first of the two exits, or at once when a signal arrives (its trap has run).
wait -n "$PROXY" "$SERVER" || true
if [ "$asked" -eq 0 ]; then
  request_stop
fi
reap() {
  local code=0
  while kill -0 "$1" 2>/dev/null; do
    wait "$1"
    code=$?
  done
  wait "$1" 2>/dev/null
  local reaped=$?
  if [ "$reaped" -ne 127 ]; then
    code=$reaped
  fi
  return "$code"
}
reap "$PROXY"
PROXY_CODE=$?
reap "$SERVER"
SERVER_CODE=$?
[ "$PROXY_CODE" -eq 0 ] && [ "$SERVER_CODE" -eq 0 ]
