{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oligarchy-dashboard",
  "main": "src/dashboard/dashboard.tsx",
  "assets": {
    "directory": "./public"
  },
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "da54bf43f004492996574a6db26d8895"
    }
  ],
  "routes": [
    { "pattern": "oligarchy.trm.sh", "custom_domain": true },
    { "pattern": "clicker.oligarchy.trm.sh", "custom_domain": true }
  ],
  // Daily at 04:00 UTC: the Worker's `scheduled` deletes every row older than thirty days.
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "placement": {
    "region": "aws:us-east-1"
  },
  // LINEAR_API_TOKEN, the key POST /abort moves a ticket with, is a wrangler secret beside these.
  "vars": {
    "AUTOMATION_SERVER_URL": "https://oligarchy-automation.trm.sh",
    "LINEAR_API_URL": "https://api.linear.app/graphql"
  }
}
