{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oligarchy-dashboard",
  "main": "src/dashboard/dashboard.tsx",
  "assets": {
    "directory": "./public"
  },
  "compatibility_date": "2026-08-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // POST /create-test-suite-run fills these into the Linear ticket, the same files ./ctrl reads.
  "rules": [
    { "type": "Text", "globs": ["**/*.md", "**/*.html"], "fallthrough": false }
  ],
  // Top-level Hyperdrive is production. `bun run dev` is `--env local`, which binds the
  // shared test Hyperdrive below. Bindings are not inherited, so each environment names its own.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "da54bf43f004492996574a6db26d8895"
    }
  ],
  "routes": [
    { "pattern": "oligarchy.trm.sh", "custom_domain": true },
    { "pattern": "clicker.oligarchy.trm.sh", "custom_domain": true }
  ],
  // Daily at 04:00 UTC: the Worker's `scheduled` deletes every row older than seven days.
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "placement": {
    "region": "aws:us-east-1"
  },
  // LINEAR_API_TOKEN, the key POST /abort moves a ticket with, and LINEAR_TEAM, the team
  // POST /create-test-suite-run files tickets on, are wrangler secrets beside these. A var set
  // in the dashboard is deleted on the next deploy, and LINEAR_TEAM has no default.
  "vars": {
    "AUTOMATION_SERVER_URL": "https://oligarchy-automation.trm.sh",
    "LINEAR_API_URL": "https://api.linear.app/graphql"
  },
  "env": {
    "local": {
      // Shared test database. `wrangler deploy --env local` would publish
      // oligarchy-dashboard-local, not the production routes.
      "workers_dev": true,
      "routes": [],
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "394204722f5c4d44bd7262be3bc2b1d6"
        }
      ],
      "vars": {
        "AUTOMATION_SERVER_URL": "https://oligarchy-automation.trm.sh",
        "LINEAR_API_URL": "https://api.linear.app/graphql"
      }
    }
  }
}
